{
  "schemaVersion": 1,
  "id": "spotifyhud",
  "version": "${version}",
  "name": "Spotify HUD Remastered",
  "description": "A lightweight cross-platform now-playing HUD for Minecraft.",
  "authors": ["arenzya"],
  "license": "MIT",
  "icon": "assets/spotifyhud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.spotifyhud.client.SpotifyHudClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
